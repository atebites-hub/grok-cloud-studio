# Grok Cloud Studio — copy to .env and fill locally. Never commit .env.
# Extra High create fails closed without a target repo URL.
# Palemon studio wipe: also copy studio.env.example → $GCS_A2A_STATE/studio.env
# (see docs/studio/WIPE.md). Generic extract start below still applies.

GCS_ROOT=
GCS_A2A_STATE=
GCS_A2A_HUB=http://127.0.0.1:8732
GCS_A2A_HOST=127.0.0.1
GCS_A2A_PORT=8732
GCS_A2A_POLL_SEC=2
GCS_A2A_REGISTRY=

GCS_DIRECTOR_SEAT=floor
# Director prompts. Empty → $ROOT/prompts if it has *_director_prompt.txt,
# else $ROOT/docs/studio/directors. Per-file lookup always searches both.
GCS_PROMPT_DIR=
# Caps which seats the bus starts and dispatch may auto-respawn.
# Default floor,studio-ops (never the full registry). skipSeats stay skipped.
GCS_ACP_SEATS=floor,studio-ops
GCS_GROW_SEATS=floor,studio-ops
GCS_SKIP_SEATS=
# Opt-in Grok Build mind (default empty). skipSeats ignored.
# Palemon-floor example (wipe: studio.env.example):
# GCS_MIND_SEATS=floor-ops,studio-ops,floor,art,content,systems,qa-a,qa-b,audio,narrative
# GCS_MIND_PLUS_ACP_WAKE=0
GCS_ACP_PORT_BASE=8740
GCS_START_SEAT_DAEMONS=0
GCS_ACP_STOP_WITH_BUS=0
# GROW stay-connected law defaults live in acp_inject.py (accept 120s,
# dead streak 3). Palemon wipe overlays inject timeout 600 via studio.env.
GCS_ACP_INJECT_TIMEOUT=600
GCS_ACP_DEAD_STREAK=3
GCS_ACP_ACCEPT_DEADLINE=120
GCS_WAKE_ACP_TIMEOUT=600
GCS_TICKER_SEC=600
# Shared grok agent leader for one-shot grok -p fallbacks. ACP serve stays --no-leader.
GROK_USE_LEADER=0

# Studio board (tcarac/taskboard). Seats wrap taskboard/ticket/tb onto this file.
# GCS_TASKBOARD_DB=
# TASKBOARD_BIN=

# Grok Bot orchestrator bind (A2A). Not an ACP inject target.
# Required for ./doctor.sh unless GCS_BOT_BIND_OPTIONAL=1 (CI clone checks).
GCS_BOT_AGENT_ID=
GCS_BOT_SEAT=orchestrator
GCS_BOT_AGENT_NAME=
# GCS_BOT_BIND_OPTIONAL=1

# Required for Extra High create (git URL Extra High should open PRs against)
GCS_CLOUD_REPO=https://github.com/atebites-hub/grok-cloud-studio
# CLOUD_REPO_URL=https://github.com/atebites-hub/grok-cloud-studio
GCS_CLOUD_REF=main
GCS_CLOUD_BACKEND=
GCS_SPAWN_WAITER=1

# Node bootstrap for @cursor/sdk (optional)
GCS_NODE=
GCS_NODE_CACHE=
GCS_NODE_DIST_VER=

# Signed webhook receiver (optional). Waiter is the fallback when unset.
# FLEET_DONE can arrive from Cursor Cloud statusChange instead of get_agent_run.
# Point dashboard / v0 webhook.url at GCS_WEBHOOK_URL (POST /webhooks/cursor-cloud).
GCS_WEBHOOK_HOST=127.0.0.1
GCS_WEBHOOK_PORT=8788
GCS_WEBHOOK_SECRET=
# GCS_WEBHOOK_URL=https://your-tunnel.example/webhooks/cursor-cloud

# Cursor Cloud auth — set in the environment or ~/.config/cursor/agent.env
# CURSOR_API_KEY=
# CURSOR_AGENT_ENV=
# CURSOR_API_BASE=
# CLOUD_FORCE_REST=0
# CLOUD_SDK_METADATA=0
