# Grok Cloud Studio — copy to .env and fill locally. Never commit .env.
# Extra High create fails closed without a target repo URL.

GCS_ROOT=
GCS_A2A_STATE=
GCS_A2A_HUB=http://127.0.0.1:8732
GCS_A2A_HOST=127.0.0.1
GCS_A2A_PORT=8732
GCS_A2A_POLL_SEC=2
GCS_A2A_REGISTRY=

GCS_DIRECTOR_SEAT=floor
GCS_PROMPT_DIR=
# Caps which seats the bus starts and dispatch may auto-respawn.
# Default floor,studio-ops (never the full registry). skipSeats stay skipped.
GCS_ACP_SEATS=floor,studio-ops
GCS_GROW_SEATS=floor,studio-ops
GCS_SKIP_SEATS=
GCS_ACP_PORT_BASE=8740
GCS_START_SEAT_DAEMONS=0
GCS_ACP_STOP_WITH_BUS=0
# Optional overrides. GROW stay-connected law defaults live in acp_inject.py
# (accept 120s, dead streak 3) — not a live studio.env patch.
GCS_ACP_INJECT_TIMEOUT=180
GCS_ACP_DEAD_STREAK=3
GCS_ACP_ACCEPT_DEADLINE=120
GCS_WAKE_ACP_TIMEOUT=600
GCS_TICKER_SEC=600
# Shared grok agent leader for one-shot grok -p fallbacks. ACP serve stays --no-leader.
GROK_USE_LEADER=0

# Grok Bot orchestrator bind (A2A). Not an ACP inject target.
# Required for ./doctor.sh unless GCS_BOT_BIND_OPTIONAL=1 (CI clone checks).
GCS_BOT_AGENT_ID=
GCS_BOT_SEAT=orchestrator
GCS_BOT_AGENT_NAME=
# GCS_BOT_BIND_OPTIONAL=1

# Required for Extra High create (git URL Extra High should open PRs against)
GCS_CLOUD_REPO=https://github.com/atebites-hub/grok-cloud-studio
# CLOUD_REPO_URL=https://github.com/atebites-hub/grok-cloud-studio
GCS_CLOUD_REF=main
GCS_CLOUD_BACKEND=
GCS_SPAWN_WAITER=1

# Node bootstrap for @cursor/sdk (optional)
GCS_NODE=
GCS_NODE_CACHE=
GCS_NODE_DIST_VER=

# Signed webhook receiver (optional). Waiter is the fallback when unset.
GCS_WEBHOOK_HOST=127.0.0.1
GCS_WEBHOOK_PORT=8788
GCS_WEBHOOK_SECRET=

# Cursor Cloud auth — set in the environment or ~/.config/cursor/agent.env
# CURSOR_API_KEY=
# CURSOR_AGENT_ENV=
# CURSOR_API_BASE=
# CLOUD_FORCE_REST=0
# CLOUD_SDK_METADATA=0

