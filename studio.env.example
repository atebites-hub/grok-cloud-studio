# Palemon studio floor knobs. Copy to $GCS_A2A_STATE/studio.env and edit locally.
# studio.env is sourced from $GCS_A2A_STATE/studio.env (start-studio-bus.sh,
# seat loops). It is not committed. Do not copy secrets into this tree.
#
# Recovered-studio layout (live box; do not hard-require these absolute paths):
#   GCS_ROOT=/workspace/palemon-floor-main          # deploy / code tree
#   GCS_A2A_STATE=/workspace/palemon/.a2a-state     # live state; never the deploy-tree .a2a-state
# Generic extract clones keep GCS_ROOT empty (this repo) and
# GCS_A2A_STATE empty ($GCS_ROOT/.a2a-state).

# GCS_ROOT=
# GCS_A2A_STATE=

# Mind is the GROW path. start-studio-bus.sh start (NO --daemons).
# Never auto-spawn a 13-seat grok agent serve floor on a ~15GB box.
GCS_MIND_SEATS=floor-ops,studio-ops,floor,art,content,systems,qa-a,qa-b
GCS_ACP_SEATS=floor-ops,floor,studio-ops,art,content,systems
GCS_GROW_SEATS=floor-ops,floor,studio-ops,art,content,systems
GCS_WAKE_SEATS=floor-ops,floor,studio-ops,art,content,systems
GCS_MIND_PLUS_ACP_WAKE=0
GCS_START_SEAT_DAEMONS=0
GROK_USE_LEADER=0

# AK stays gone. Omit this knob, or leave it 0. Do not reconnect Agent Kanban.
PALEMON_AK_BRIDGE=0

# Grok Bot seats stay standby. bot-bridge wakes Bot inboxes; default off.
GCS_BOT_BRIDGE=0

# Overlay timeouts for this floor. Do not live-patch acp_inject.py defaults.
GCS_ACP_INJECT_TIMEOUT=600
GCS_WAKE_ACP_TIMEOUT=600
GCS_ACP_ACCEPT_DEADLINE=120
GCS_TICKER_SEC=600
GCS_ACP_DEAD_STREAK=3

# Board SQLite (tcarac/taskboard). Default: $GCS_A2A_STATE/taskboard/taskboard.db
# GCS_TASKBOARD_DB=
# TASKBOARD_BIN=

# GCS_MIND_RUNNER=auto   # persist $GCS_A2A_STATE/<seat>/mind/runner; switch on quota
# GCS_MIND_RUNNER=grok   # forced; does not flip
# GCS_MIND_RUNNER=cursor # forced; does not flip
GCS_MIND_RUNNER=auto

# CURSOR_API_KEY — set in the environment or ~/.config/cursor/agent.env
# (never print, never commit). Grok Build HTTP 402: mind SWITCH (auto)
# retries that same mail line on the other runner; not a wipe blocker.

# Tailscale Serve is opt-in after the node is already joined.
# PALEMON_TAILSCALE_SERVE=0 skips scripts/studio/taskboard/start-tailscale-serve.sh
# Never write Tailscale auth key values into this file or the repo.
