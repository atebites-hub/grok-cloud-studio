#!/usr/bin/env bash
# gcs-host-taskboard-wrapper
# Host wipe-box `tb` alias for `ticket`. Not a GROK_HOME copy.
set -euo pipefail

_gcs_host_tb_script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
  done
  cd "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_gcs_host_tb_script_dir)"
exec "$SCRIPT_DIR/ticket" "$@"
