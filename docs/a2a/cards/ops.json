{
  "name": "Ops",
  "description": "Keep the local bus, seat daemons, and watchdog healthy. Activate daemons only when opted in.",
  "version": "1.0.0",
  "protocolVersion": "1.0",
  "provider": {
    "organization": "Grok Cloud Studio",
    "url": "https://github.com/atebites-hub/grok-cloud-studio"
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "defaultInputModes": [
    "text/plain",
    "application/json"
  ],
  "defaultOutputModes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "bus",
      "name": "Studio bus",
      "description": "Start/stop/status hub, dispatch, shepherd, optional ACP daemons",
      "tags": [
        "ops",
        "bus"
      ]
    }
  ],
  "supportedInterfaces": [
    {
      "url": "http://127.0.0.1:8732/a2a/ops",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ]
}
